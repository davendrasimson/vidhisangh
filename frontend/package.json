{
  "name": "vidhisangh-frontend",
  "version": "0.1.0",
  "description": "VidhiSangh — integrated legal ecosystem (Angular 21 PWA).",
  "scripts": {
    "start": "ng serve --port 4200",
    "build": "node scripts/build-act-pages.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "ng lint",
    "test:e2e": "npm run build && playwright test",
    "docs:help": "node --experimental-strip-types scripts/generate-help.mjs",
    "build:mobile": "ng build --configuration production,mobile && cap sync",
    "android:apk": "npm run build:mobile && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build:mobile && cd android && ./gradlew bundleRelease assembleRelease",
    "build:acts": "node scripts/build-act-pages.mjs",
    "publish:app-update": "node scripts/publish-app-update.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.24",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/forms": "21.2.24",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.24",
    "@angular/platform-server": "21.2.24",
    "@angular/router": "21.2.24",
    "@angular/service-worker": "21.2.24",
    "@angular/ssr": "21.2.24",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-updater": "8.52.1",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/tiro-devanagari-hindi": "5.3.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-subscript": "^3.34.0",
    "@tiptap/extension-superscript": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "material-icons": "1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.24",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.9",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.0"
  }
}
