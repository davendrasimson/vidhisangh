# ════════════════════════════════════════════════════════════════════
#  VidhiSangh backend — environment template
#  Copy to backend/.env and fill in. NEVER commit a real .env (ignored).
#  Every variable is read by app/core/config.py with the VS_ prefix.
#  Values below are placeholders / safe local defaults, not secrets.
# ════════════════════════════════════════════════════════════════════

# ─── Runtime ────────────────────────────────────────────────────────
VS_ENVIRONMENT=local                      # local | dev | staging | production
VS_DEBUG=false
VS_PROJECT_NAME=VidhiSangh
VS_API_V1_PREFIX=/api/v1
VS_LOG_LEVEL=INFO
VS_LOG_JSON=false
VS_BACKEND_CORS_ORIGINS=http://localhost:4200
VS_PUBLIC_APP_URL=http://localhost:4200   # base for links sent out (KYC, portal)
VS_EXPOSE_API_DOCS=true                   # must be false in production
VS_METRICS_TOKEN=                         # bearer token for /metrics (set in production)

# ─── Database ───────────────────────────────────────────────────────
VS_POSTGRES_HOST=localhost
VS_POSTGRES_PORT=5432
VS_POSTGRES_USER=vidhisangh_app
VS_POSTGRES_PASSWORD=change-me
VS_POSTGRES_DB=vidhisangh
VS_POSTGRES_POOL_SIZE=10
VS_POSTGRES_MAX_OVERFLOW=20
VS_DATABASE_URL=                          # optional explicit postgresql+asyncpg:// DSN
VS_DB_ROLE_CHECK=true                     # refuse to boot as superuser / BYPASSRLS
VS_DB_SSL_MODE=                           # disable | require | verify-ca | verify-full
                                          # (default: disable for localhost, require otherwise)
VS_DB_SSL_ROOT_CERT=                      # CA bundle path for verify-ca / verify-full
VS_DB_STATEMENT_TIMEOUT_MS=30000          # per-connection statement_timeout
VS_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# ─── Redis / Celery ─────────────────────────────────────────────────
VS_REDIS_URL=redis://:change-me@localhost:6379/0
VS_CELERY_BROKER_URL=redis://:change-me@localhost:6379/1
VS_CELERY_RESULT_BACKEND=redis://:change-me@localhost:6379/2

# ─── Security / JWT ─────────────────────────────────────────────────
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
VS_SECRET_KEY=change-me-to-a-64-byte-random-value-______________________________
VS_REFRESH_TOKEN_PEPPER=
VS_BACKUP_CODE_PEPPER=
VS_LINK_TOKEN_PEPPER=
VS_BLIND_INDEX_PEPPER=
VS_FIELD_ENCRYPTION_KEYS=                 # key-id:base64key[,key-id:base64key] (first = active)
VS_JWT_ALGORITHM=ES256                    # HS256 | RS256 | ES256 (asymmetric required in production)
VS_JWT_PRIVATE_KEY_PATH=/opt/vidhisangh/.secrets/jwt_private.pem
VS_JWT_PUBLIC_KEY_PATH=/opt/vidhisangh/.secrets/jwt_public.pem
VS_ACCESS_TOKEN_EXPIRE_MINUTES=15
VS_REFRESH_TOKEN_EXPIRE_DAYS=14
VS_REFRESH_REUSE_GRACE_SECONDS=60
VS_REFRESH_TOKEN_IN_BODY=false            # true only for non-browser clients
VS_REFRESH_COOKIE_NAME=vs_refresh
VS_PASSWORD_MIN_LENGTH=12
VS_MFA_ISSUER=VidhiSangh
VS_LOGIN_MAX_FAILED_ATTEMPTS=5
VS_LOGIN_LOCKOUT_MINUTES=15
VS_PASSWORD_RESET_EXPIRE_MINUTES=30
VS_INVITE_TOKEN_EXPIRE_DAYS=7
VS_EMAIL_VERIFICATION_EXPIRE_HOURS=48
VS_INVITES_RETURN_TEMP_PASSWORD=false
VS_PORTAL_ACCESS_EXPIRE_DAYS=90
VS_WS_TICKET_TTL_SECONDS=60

# ─── OAuth / SSO ────────────────────────────────────────────────────
VS_OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:4200
VS_OAUTH_MOCK_ENABLED=false               # never true outside a developer machine
VS_OAUTH_GOOGLE_CLIENT_ID=
VS_OAUTH_GOOGLE_CLIENT_SECRET=
VS_OAUTH_MICROSOFT_CLIENT_ID=
VS_OAUTH_MICROSOFT_CLIENT_SECRET=
VS_OAUTH_LINKEDIN_CLIENT_ID=
VS_OAUTH_LINKEDIN_CLIENT_SECRET=

# ─── Passkeys (WebAuthn) ────────────────────────────────────────────
VS_WEBAUTHN_RP_ID=localhost
VS_WEBAUTHN_RP_NAME=VidhiSangh
VS_WEBAUTHN_ORIGIN=http://localhost:4200

# ─── Rate limiting ──────────────────────────────────────────────────
VS_RATE_LIMITING_ENABLED=true
VS_TRUSTED_PROXY_IPS=127.0.0.1,::1        # only these may set X-Forwarded-For
VS_RATE_LIMIT_PER_MINUTE=120
VS_AUTH_RATE_LIMIT_PER_MINUTE=10
VS_AUTH_ACCOUNT_RATE_LIMIT_PER_MINUTE=10
VS_REGISTER_RATE_LIMIT_PER_MINUTE=5
VS_REFRESH_RATE_LIMIT_PER_MINUTE=120
VS_MFA_RATE_LIMIT_PER_MINUTE=10
VS_PUBLIC_TOKEN_RATE_LIMIT_PER_MINUTE=30
VS_LINK_PREVIEW_RATE_LIMIT_PER_MINUTE=20
VS_UPLOAD_RATE_LIMIT_PER_MINUTE=30
VS_WS_HANDSHAKE_RATE_LIMIT_PER_MINUTE=30

# ─── Document storage ───────────────────────────────────────────────
VS_STORAGE_BACKEND=local                  # local | s3 | memory (memory: tests only)
VS_STORAGE_DIR=/var/lib/vidhisangh/documents   # required for local; no temp default
VS_MAX_UPLOAD_BYTES=26214400              # 25 MiB — keep nginx client_max_body_size in step
VS_ALLOWED_UPLOAD_TYPES=                  # comma list of MIME types/extensions; empty = built-in set
VS_S3_ENDPOINT_URL=                       # e.g. http://localhost:9000 for MinIO; empty = AWS
VS_S3_REGION=ap-south-1
VS_S3_BUCKET=vidhisangh-documents
VS_S3_ACCESS_KEY=
VS_S3_SECRET_KEY=
VS_S3_USE_SSL=true
VS_S3_KMS_KEY_ID=                         # set → SSE-KMS; empty → SSE-S3 (AES256)

# ─── Search ─────────────────────────────────────────────────────────
VS_OPENSEARCH_URL=http://localhost:9200

# ─── AI / LLM ───────────────────────────────────────────────────────
VS_LLM_PROVIDER=anthropic                 # anthropic | openai | azure_openai | local
VS_ANTHROPIC_API_KEY=
VS_OPENAI_API_KEY=
VS_AZURE_OPENAI_ENDPOINT=
VS_AZURE_OPENAI_API_KEY=
VS_LOCAL_LLM_BASE_URL=
VS_VECTOR_DB_URL=

# ─── Notifications ──────────────────────────────────────────────────
VS_SMTP_HOST=
VS_SMTP_PORT=587
VS_SMTP_USER=
VS_SMTP_PASSWORD=
# Production alternative: path to a systemd credential decrypted at runtime.
VS_SMTP_PASSWORD_FILE=
VS_SMTP_FROM=no-reply@vidhisangh.com
VS_SMTP_TLS=true
VS_SMTP_SSL=false
VS_SLACK_WEBHOOK=

# ─── Payments (Razorpay) ────────────────────────────────────────────
VS_RAZORPAY_KEY_ID=
VS_RAZORPAY_KEY_SECRET=
VS_RAZORPAY_WEBHOOK_SECRET=

# ─── Integrations ───────────────────────────────────────────────────
VS_ECOURTS_PROVIDER=mock                  # mock | live
VS_NEWS_FEEDS=[]                          # JSON array of {name,url,category}
VS_LEGISLATIVE_API_KEY=                   # scripts/fetch_bare_acts.py (Legislative Dept API)
