# ════════════════════════════════════════════════════════════════════
#  VidhiSangh — docker-compose environment template
#  Copy to ./.env and fill in. NEVER commit a real .env (ignored).
#
#  compose refuses to start without the values marked (required): every
#  credential is `${VAR:?}` in docker-compose.yml — there are no defaults.
#  The backend/worker containers also read this file (env_file: .env), so
#  the full VS_* set from backend/.env.example may be added here as well.
# ════════════════════════════════════════════════════════════════════

# ─── Infrastructure credentials (required) ──────────────────────────
VS_POSTGRES_USER=vidhisangh
VS_POSTGRES_PASSWORD=change-me-postgres
VS_POSTGRES_DB=vidhisangh
REDIS_PASSWORD=change-me-redis
VS_S3_ACCESS_KEY=change-me-minio-access-key      # >= 3 chars
VS_S3_SECRET_KEY=change-me-minio-secret-key      # >= 8 chars
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Change-me-OpenSearch-1!   # strong: upper/lower/digit/symbol

# ─── Backend (required in every environment) ────────────────────────
VS_ENVIRONMENT=local
VS_SECRET_KEY=change-me-to-a-64-byte-random-value-______________________________
VS_BACKEND_CORS_ORIGINS=http://localhost:4200
VS_PUBLIC_APP_URL=http://localhost:4200
VS_STORAGE_BACKEND=s3
VS_S3_BUCKET=vidhisangh-documents
VS_S3_USE_SSL=false
VS_MAX_UPLOAD_BYTES=26214400

# ─── Optional (see backend/.env.example for the complete list) ──────
VS_LOG_LEVEL=INFO
VS_EXPOSE_API_DOCS=true
VS_ANTHROPIC_API_KEY=
VS_SMTP_HOST=
VS_SMTP_USER=
VS_SMTP_PASSWORD=
