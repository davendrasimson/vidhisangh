# Failure notifier for every VidhiSangh timer job (OnFailure=vidhisangh-job-failed@%n).
# Writes the failed unit's last 40 log lines to the ops log and sends a concise
# SMTP alert. The mailbox password is supplied as a systemd credential.
[Unit]
Description=Alert: VidhiSangh job %i failed

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=-/opt/vidhisangh/.secrets/ops.env
LoadCredentialEncrypted=smtp_password:/etc/credstore.encrypted/vidhisangh.smtp_password
Environment=VS_SMTP_PASSWORD_FILE=%d/smtp_password
ExecStart=/usr/bin/python3 /opt/vidhisangh/infra/jobs/job-failed-alert.py %i
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/vidhisangh/backups
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
