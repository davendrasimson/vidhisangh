# Daily at 01:30 IST = 20:00 UTC (the host clock is UTC; India has no DST).
# Install: /etc/systemd/system/backup-db.timer ; systemctl enable --now backup-db.timer
[Unit]
Description=VidhiSangh nightly backup timer (01:30 IST)

[Timer]
OnCalendar=*-*-* 20:00:00 UTC
RandomizedDelaySec=600
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
