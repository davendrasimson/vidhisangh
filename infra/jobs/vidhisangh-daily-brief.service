[Unit]
Description=VidhiSangh Daily: post today's official items, push the morning brief to members with the app, WhatsApp it to members who asked
After=network-online.target postgresql.service
OnFailure=vidhisangh-job-failed@%n.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/vidhisangh/backend
EnvironmentFile=/opt/vidhisangh/backend/.env
Environment=PYTHONPATH=/opt/vidhisangh/backend
# Push to the app (Firebase key, the same credential the API uses).
LoadCredentialEncrypted=fcm_key:/etc/credstore.encrypted/vidhisangh.fcm_key
Environment=VS_FCM_CREDENTIALS_FILE=%d/fcm_key
# WhatsApp (template vidhisangh_daily on +91 73411 00692) to members who said yes to
# VidhiSangh Daily on WhatsApp; the same encrypted token the API and the other jobs use.
LoadCredentialEncrypted=wa_access_token:/etc/credstore.encrypted/vidhisangh.wa_access_token
Environment=VS_WA_ACCESS_TOKEN_FILE=%d/wa_access_token
Environment=VS_WA_PHONE_NUMBER_ID=1414403508414088
# The email version (17 Nov 2026) sends through the notifications SMTP, whose password is the
# same encrypted credential the API and the Supreme Court orders job load.
LoadCredentialEncrypted=smtp_password:/etc/credstore.encrypted/vidhisangh.smtp_password
Environment=VS_SMTP_PASSWORD_FILE=%d/smtp_password
ExecStart=/opt/vidhisangh/backend/.venv/bin/python -m app.scripts.daily_brief
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
