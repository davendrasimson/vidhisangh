[Unit]
Description=VidhiSangh morning digest of the matters needing attention (push to the app; WhatsApp once a template is approved)
After=network-online.target postgresql.service
OnFailure=vidhisangh-job-failed@%n.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/vidhisangh/backend
EnvironmentFile=/opt/vidhisangh/backend/.env
Environment=PYTHONPATH=/opt/vidhisangh/backend
# VidhiSangh's WhatsApp number (+91 73411 00692); the token is the same
# encrypted credential the API uses for sign-in codes.
LoadCredentialEncrypted=wa_access_token:/etc/credstore.encrypted/vidhisangh.wa_access_token
Environment=VS_WA_ACCESS_TOKEN_FILE=%d/wa_access_token
Environment=VS_WA_PHONE_NUMBER_ID=1414403508414088
# Push to the app (Firebase key, the same credential the API uses).
LoadCredentialEncrypted=fcm_key:/etc/credstore.encrypted/vidhisangh.fcm_key
Environment=VS_FCM_CREDENTIALS_FILE=%d/fcm_key
ExecStart=/opt/vidhisangh/backend/.venv/bin/python -m app.scripts.matter_board_digest
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
