[Unit]
Description=VidhiSangh daily fee sweep: retainer periods and dated milestones fall due
After=network-online.target postgresql.service
OnFailure=vidhisangh-job-failed@%n.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/vidhisangh/backend
EnvironmentFile=/opt/vidhisangh/backend/.env
Environment=PYTHONPATH=/opt/vidhisangh/backend
ExecStart=/opt/vidhisangh/backend/.venv/bin/python -m app.scripts.fee_sweep
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
