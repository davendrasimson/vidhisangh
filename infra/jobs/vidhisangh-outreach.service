[Unit]
Description=VidhiSangh invitation emails (at most 500 a day; paused/resumed in Platform admin)
After=network-online.target postgresql.service
OnFailure=vidhisangh-job-failed@%n.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/vidhisangh/backend
EnvironmentFile=/opt/vidhisangh/backend/.env
Environment=PYTHONPATH=/opt/vidhisangh/backend
ExecStart=/opt/vidhisangh/backend/.venv/bin/python -m app.scripts.outreach_send
# 500 messages spaced 10-30 s apart take up to ~4 hours.
TimeoutStartSec=16000
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
